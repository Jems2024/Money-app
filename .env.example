# ==============================================================================
# STOP SPEND — CONFIGURACIÓN DE ENTORNO (.env.example)
# Proyecto Supabase: STOP SPEND (Ref: zsnvclyoypabmgqqaizj | Región: us-east-1)
# ==============================================================================
# REGLAS DE SEGURIDAD:
# 1. Las variables con prefijo VITE_* son PÚBLICAS y se empaquetan en el navegador.
#    Solo pon aquí la URL del proyecto y la clave pública (Publishable key / Anon key).
# 2. NUNCA pongas SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_PASSWORD, SUPABASE_ACCESS_TOKEN
#    ni claves privadas de Enable Banking o VAPID en variables VITE_* ni en el chat.
# 3. Copia este archivo a `.env.local` (ignorado por Git) en tu máquina local.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VALORES PÚBLICOS DE FRONTEND (.env.local / Variables de entorno del Hosting)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://zsnvclyoypabmgqqaizj.supabase.co
# Puedes usar la nueva Publishable Key (sb_publishable_...) o la Legacy Anon Key (eyJ...)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

VITE_APP_ENV=production
VITE_DEFAULT_TIMEZONE=Europe/Madrid
VITE_DEFAULT_CURRENCY=EUR
VITE_DEFAULT_LOCALE=es-ES
# Clave pública VAPID (Base64URL) para suscripción Web Push en iPhone (Safari PWA)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-base64url-placeholder
# Mantener en 'unconfigured' hasta disponer de App ID, clave RSA y cuenta vinculada en Enable Banking
VITE_BANK_PROVIDER_MODE=unconfigured

# ------------------------------------------------------------------------------
# 2. SECRETOS EXCLUSIVOS DE SERVIDOR (Supabase Edge Function Secrets — NUNCA en VITE_*)
# Configurar mediante: npx supabase secrets set NOMBRE=valor --project-ref zsnvclyoypabmgqqaizj
# ------------------------------------------------------------------------------
SUPABASE_URL=https://zsnvclyoypabmgqqaizj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key-placeholder
APP_ENCRYPTION_KEY_BASE64=your-32-byte-aes-gcm-master-key-base64-placeholder
APP_ALLOWED_ORIGINS=https://jems2024.github.io,http://localhost:5173,http://localhost:4173

# --- Enable Banking (Servidor únicamente; dejar vacío hasta configurar CaixaBank) ---
ENABLE_BANKING_ENV=unconfigured
ENABLE_BANKING_BASE_URL=https://api.enablebanking.com
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PEM=
ENABLE_BANKING_REDIRECT_URI=https://jems2024.github.io/Money-app/auth/bank/callback
ENABLE_BANKING_DEFAULT_ASPSP_COUNTRY=ES
ENABLE_BANKING_DEFAULT_ASPSP_NAME=CaixaBank

# --- Web Push VAPID (Servidor únicamente) ---
VAPID_SUBJECT=mailto:jared@stopspend.es
VAPID_PUBLIC_KEY=your-vapid-public-key-base64url-placeholder
VAPID_PRIVATE_KEY_JWK={"kty":"EC","crv":"P-256","x":"placeholder","y":"placeholder","d":"placeholder"}
